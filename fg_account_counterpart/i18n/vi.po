#. odoo-python
#: code:addons/fg_account_counterpart/wizard/account_counterpart_generate.py:0
msgid ""
"%(count)s of them are not fully countered: entries with negative amounts are"
" not supported yet."
msgstr ""
"%(count)s bút toán trong số đó chưa được đối ứng hoàn toàn: bút toán có số "
"tiền âm hiện chưa được hỗ trợ."

