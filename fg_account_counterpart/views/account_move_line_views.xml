<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">account.move.line.list.counterpart</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="countered_account_ids" widget="many2many_tags" optional="show" readonly="1"/>
                <field name="countered_status" optional="hide" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_form" model="ir.ui.view">
        <field name="name">account.move.line.form.counterpart</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <page name="information" position="after">
                <page string="Counterparts" name="counterparts">
                    <group>
                        <group>
                            <field name="countered_account_ids" widget="many2many_tags"/>
                            <field name="countered_amt"/>
                            <field name="countered_status"/>
                        </group>
                    </group>
                    <field name="countered_aml_ids">
                        <list>
                            <field name="account_id"/>
                            <field name="partner_id" optional="hide"/>
                            <field name="name"/>
                            <field name="debit" sum="Total Debit"/>
                            <field name="credit" sum="Total Credit"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="view_account_move_line_filter" model="ir.ui.view">
        <field name="name">account.move.line.search.counterpart</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="countered_account_ids"/>
            </field>
            <filter name="group_by_account" position="after">
                <filter string="Countered Status" name="group_by_countered_status" context="{'group_by': 'countered_status'}"/>
            </filter>
        </field>
    </record>
</odoo>
