<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Report Template -->
    <template id="report_stock_valuation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-call="fg_stock_reports_l10n_vn_ce.report_stock_valuation_base"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Report Base Content -->
    <template id="report_stock_valuation_base">
        <style>
            @page {
                size: A4 landscape;
                margin: 10mm;
            }
            body {
                font-family: 'DejaVu Sans', 'Noto Sans', Arial, sans-serif;
                font-size: 11px;
            }
            .report_title {
                text-align: center;
                font-size: 16px;
                font-weight: bold;
                margin-bottom: 10px;
            }
            .report_subtitle {
                text-align: center;
                font-size: 12px;
                margin-bottom: 8px;
            }
            .filters {
                margin-bottom: 10px;
                font-size: 10px;
            }
            .filter_row {
                margin-bottom: 3px;
            }
            .filter_label {
                font-weight: bold;
                display: inline-block;
                width: 80px;
            }
            .data_table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 5px;
                font-size: 12px;
            }
            .data_table th {
                background-color: #4472C4;
                color: white;
                padding: 5px 4px;
                text-align: center;
                border: 1px solid #2E5A8B;
                font-weight: bold;
                font-size: 12px;
            }
            .data_table td {
                padding: 4px 5px;
                border: 1px solid #ccc;
                font-size: 12px;
            }
            .data_table tr:nth-child(even) {
                background-color: #f5f5f5;
            }
            .text-right {
                text-align: right;
            }
            .text-center {
                text-align: center;
            }
            .category_row {
                background-color: #E2EFDA !important;
                font-weight: bold;
            }
            .total_row {
                background-color: #FFF2CC !important;
                font-weight: bold;
            }
            .o_stock_report_qty {
                color: #006600;
            }
            .o_stock_report_value {
                color: #0066cc;
            }
        </style>
        
        <div class="page">
            <!-- Report Title -->
            <div class="report_title">
                BÁO CÁO XUẤT NHẬP TỒN
            </div>
            <div class="report_subtitle">
                <t t-out="company_name"/> - <t t-out="currency_name"/>
            </div>

            <!-- Filters Section -->
            <div class="filters">
                <div class="filter_row">
                    <span class="filter_label">Từ ngày:</span>
                    <span t-out="date_from"/>
                </div>
                <div class="filter_row">
                    <span class="filter_label">Đến ngày:</span>
                    <span t-out="date_to"/>
                </div>
                <div class="filter_row">
                    <span class="filter_label">Công ty:</span>
                    <span t-out="company_name"/>
                </div>
            </div>

            <!-- Data Table -->
            <table class="data_table">
                <thead>
                    <tr>
                        <th style="width: 3%;">STT</th>
                        <th style="width: 5%;">Mã SP</th>
                        <th style="width: 23%;">Tên sản phẩm</th>
                        <th style="width: 5%;">ĐVT</th>
                        <th style="width: 7%;">SL Đầu kỳ</th>
                        <th style="width: 9%;">GT Đầu kỳ</th>
                        <th style="width: 7%;">SL Nhập</th>
                        <th style="width: 9%;">GT Nhập</th>
                        <th style="width: 7%;">SL Xuất</th>
                        <th style="width: 9%;">GT Xuất</th>
                        <th style="width: 7%;">SL Cuối kỳ</th>
                        <th style="width: 9%;">GT Cuối kỳ</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="sequence" t-value="0"/>
                    <t t-foreach="report_lines" t-as="line">
                        <t t-if="line.get('type') == 'category'">
                            <!-- Category Row -->
                            <tr class="category_row">
                                <td></td>
                                <td colspan="3"><t t-out="line.get('name')"/></td>
                                <td class="text-right">
                                    <t t-out="'%.2f' % line.get('opening_qty', 0)"/>
                                </td>
                                <td class="text-right">
                                    <t t-out="'{:,.0f}'.format(line.get('opening_value', 0))"/>
                                </td>
                                <td class="text-right">
                                    <t t-out="'%.2f' % line.get('increase_qty', 0)"/>
                                </td>
                                <td class="text-right">
                                    <t t-out="'{:,.0f}'.format(line.get('increase_value', 0))"/>
                                </td>
                                <td class="text-right">
                                    <t t-out="'%.2f' % line.get('decrease_qty', 0)"/>
                                </td>
                                <td class="text-right">
                                    <t t-out="'{:,.0f}'.format(line.get('decrease_value', 0))"/>
                                </td>
                                <td class="text-right">
                                    <t t-out="'%.2f' % line.get('closing_qty', 0)"/>
                                </td>
                                <td class="text-right">
                                    <t t-out="'{:,.0f}'.format(line.get('closing_value', 0))"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <!-- Product Row -->
                            <t t-set="sequence" t-value="sequence + 1"/>
                            <t t-set="product_id" t-value="line.get('product_id')"/>
                            
                            <!-- Build domains for this product -->
                            <t t-set="domain_move_in" t-value="'[(\'product_id\', \'=\', %d), (\'state\', \'=\', \'done\'), (\'date\', \'&gt;=\', \'%s\'), (\'date\', \'&lt;=\', \'%s\'), (\'location_dest_id.usage\', \'=\', \'internal\'), (\'location_id.usage\', \'!=\', \'internal\')]' % (product_id, date_from, date_to)"/>
                            <t t-set="domain_move_out" t-value="'[(\'product_id\', \'=\', %d), (\'state\', \'=\', \'done\'), (\'date\', \'&gt;=\', \'%s\'), (\'date\', \'&lt;=\', \'%s\'), (\'location_id.usage\', \'=\', \'internal\'), (\'location_dest_id.usage\', \'!=\', \'internal\')]' % (product_id, date_from, date_to)"/>
                            <t t-set="domain_svl_in" t-value="'[(\'product_id\', \'=\', %d), (\'quantity\', \'&gt;\', 0), (\'stock_move_id.date\', \'&gt;=\', \'%s\'), (\'stock_move_id.date\', \'&lt;=\', \'%s 23:59:59\')]' % (product_id, date_from, date_to)"/>
                            <t t-set="domain_svl_out" t-value="'[(\'product_id\', \'=\', %d), (\'quantity\', \'&lt;\', 0), (\'stock_move_id.date\', \'&gt;=\', \'%s\'), (\'stock_move_id.date\', \'&lt;=\', \'%s 23:59:59\')]' % (product_id, date_from, date_to)"/>
                            
                            <tr>
                                <td class="text-center"><t t-out="sequence"/></td>
                                <td><t t-out="line.get('default_code', '')"/></td>
                                <td><t t-out="line.get('product_name', '')"/></td>
                                <td class="text-center"><t t-out="line.get('uom_name', '')"/></td>
                                <!-- SL Đầu kỳ -->
                                <td class="o_stock_report_qty text-right">
                                    <t t-out="'%.2f' % line.get('opening_qty', 0)"/>
                                </td>
                                <!-- GT Đầu kỳ -->
                                <td class="o_stock_report_value text-right">
                                    <t t-out="'{:,.0f}'.format(line.get('opening_value', 0))"/>
                                </td>
                                <!-- SL Nhập - Clickable to Stock Moves -->
                                <td class="text-right">
                                    <span class="o_stock_report_qty"
                                          res-model="stock.move"
                                          t-att-domain="domain_move_in"
                                          action-name="Phiếu nhập kho">
                                        <t t-out="'%.2f' % line.get('increase_qty', 0)"/>
                                    </span>
                                </td>
                                <!-- GT Nhập - Clickable to Valuation Layer -->
                                <td class="text-right">
                                    <span class="o_stock_report_value"
                                          res-model="stock.valuation.layer"
                                          t-att-domain="domain_svl_in"
                                          action-name="Chi tiết giá trị nhập">
                                        <t t-out="'{:,.0f}'.format(line.get('increase_value', 0))"/>
                                    </span>
                                </td>
                                <!-- SL Xuất - Clickable to Stock Moves -->
                                <td class="text-right">
                                    <span class="o_stock_report_qty"
                                          res-model="stock.move"
                                          t-att-domain="domain_move_out"
                                          action-name="Phiếu xuất kho">
                                        <t t-out="'%.2f' % line.get('decrease_qty', 0)"/>
                                    </span>
                                </td>
                                <!-- GT Xuất - Clickable to Valuation Layer -->
                                <td class="text-right">
                                    <span class="o_stock_report_value"
                                          res-model="stock.valuation.layer"
                                          t-att-domain="domain_svl_out"
                                          action-name="Chi tiết giá trị xuất">
                                        <t t-out="'{:,.0f}'.format(line.get('decrease_value', 0))"/>
                                    </span>
                                </td>
                                <!-- SL Cuối kỳ -->
                                <td class="o_stock_report_qty text-right">
                                    <t t-out="'%.2f' % line.get('closing_qty', 0)"/>
                                </td>
                                <!-- GT Cuối kỳ -->
                                <td class="o_stock_report_value text-right">
                                    <t t-out="'{:,.0f}'.format(line.get('closing_value', 0))"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <!-- Total Row -->
                    <tr class="total_row">
                        <td></td>
                        <td colspan="3"><strong>TỔNG CỘNG</strong></td>
                        <td class="text-right">
                            <strong> </strong>
                        </td>
                        <td class="text-right">
                            <strong><t t-out="'{:,.0f}'.format(totals.get('opening_value', 0))"/></strong>
                        </td>
                        <td class="text-right">
                            <strong> </strong>
                        </td>
                        <td class="text-right">
                            <strong><t t-out="'{:,.0f}'.format(totals.get('increase_value', 0))"/></strong>
                        </td>
                        <td class="text-right">
                            <strong> </strong>
                        </td>
                        <td class="text-right">
                            <strong><t t-out="'{:,.0f}'.format(totals.get('decrease_value', 0))"/></strong>
                        </td>
                        <td class="text-right">
                            <strong> </strong>
                        </td>
                        <td class="text-right">
                            <strong><t t-out="'{:,.0f}'.format(totals.get('closing_value', 0))"/></strong>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>
