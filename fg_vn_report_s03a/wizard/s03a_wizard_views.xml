<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vn_report_s03a_wizard_form" model="ir.ui.view">
        <field name="name">vn.report.s03a.wizard.form</field>
        <field name="model">vn.report.s03a.wizard</field>
        <field name="arch" type="xml">
            <form string="General Journal">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="report_lang"/>
                    </group>
                    <group string="Filters">
                        <field name="move_type"/>
                        <field name="journal_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All journals"/>
                        <field name="account_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All accounts"/>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All partners"/>
                    </group>
                </group>
                <group string="PDF Printing">
                    <group>
                        <field name="orientation"/>
                    </group>
                    <group>
                        <field name="mirror_margin"/>
                        <field name="gutter_mm" invisible="not mirror_margin"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" string="View" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_export_xlsx" string="Excel" type="object" class="btn-secondary" icon="table"/>
                    <button name="action_export_pdf_rl" string="PDF" type="object" class="btn-secondary" icon="picture_as_pdf"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vn_report_s03a_wizard" model="ir.actions.act_window">
        <field name="name">General Journal</field>
        <field name="res_model">vn.report.s03a.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
